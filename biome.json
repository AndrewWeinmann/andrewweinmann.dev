{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"assist": {
		"actions": {
			"recommended": true
		},
		"enabled": true
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": ["./*", "src/**", "tests/**", "!!**/coverage", "!!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"jsxQuoteStyle": "double",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"playwright": "all",
			"project": "all",
			"react": "all",
			"test": "all",
			"types": "all"
		},
		"rules": {
			"recommended": true
		}
	},
	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true,
		"useIgnoreFile": true
	}
}
